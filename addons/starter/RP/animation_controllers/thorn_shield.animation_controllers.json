{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.starter.thorn_shield.wield": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "hide_block",
            { "wield_main_hand_first_person": "c.item_slot == 'main_hand'" },
            { "wield_off_hand_first_person": "c.item_slot != 'main_hand'" }
          ],
          "transitions": [
            { "blocking": "variable.is_blocking_main_hand || variable.is_blocking_off_hand" },
            { "third_person": "!c.is_first_person" }
          ]
        },
        "blocking": {
          "animations": [
            "hide_block",
            { "wield_main_hand_first_person": "!variable.is_blocking_main_hand && c.item_slot == 'main_hand'" },
            { "wield_main_hand_first_person_block": "variable.is_blocking_main_hand && c.item_slot == 'main_hand'" },
            { "wield_off_hand_first_person_block": "variable.is_blocking_off_hand && c.item_slot == 'off_hand'" }
          ],
          "transitions": [
            { "default": "!variable.is_blocking_main_hand && !variable.is_blocking_off_hand" },
            { "third_person": "!c.is_first_person" }
          ]
        },
        "third_person": {
          "animations": [
            { "wield_third_person": "!variable.is_blocking_main_hand && !variable.is_blocking_off_hand" },
            { "hide_hand": "variable.is_blocking_main_hand || variable.is_blocking_off_hand" },
            { "hide_block": "!variable.is_blocking_main_hand && !variable.is_blocking_off_hand" }
          ],
          "transitions": [{ "default": "c.is_first_person" }]
        }
      }
    }
  }
}
