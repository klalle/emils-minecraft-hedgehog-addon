{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.starter.slingshot.wield": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            { "first_person_main": "c.item_slot == 'main_hand'" },
            { "first_person_off": "c.item_slot != 'main_hand'" }
          ],
          "transitions": [{ "third_person": "!c.is_first_person" }]
        },
        "third_person": {
          "animations": ["third_person"],
          "transitions": [{ "default": "c.is_first_person" }]
        }
      }
    }
  }
}
