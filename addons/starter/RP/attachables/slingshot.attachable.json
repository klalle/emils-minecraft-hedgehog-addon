{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "starter:slingshot",
      "materials": { "default": "entity_alphatest", "enchanted": "entity_alphatest_glint" },
      "textures": {
        "default": "textures/attachables/slingshot",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": { "default": "geometry.starter.slingshot" },
      "animations": {
        "wield": "controller.animation.starter.slingshot.wield",
        "first_person": "animation.starter.slingshot.first_person",
        "third_person": "animation.starter.slingshot.third_person",
        "tune": "animation.starter.slingshot.tune"
      },
      "scripts": {
        "pre_animation": [
          "variable.on = query.player_level >= 1000000 && query.player_level < 2000000;",
          "variable.d0 = math.mod(query.player_level, 10);",
          "variable.d1 = math.mod(math.floor(query.player_level / 10), 10);",
          "variable.d2 = math.mod(math.floor(query.player_level / 100), 10);",
          "variable.d3 = math.mod(math.floor(query.player_level / 1000), 10);",
          "variable.d4 = math.mod(math.floor(query.player_level / 10000), 10);",
          "variable.d5 = math.mod(math.floor(query.player_level / 100000), 10);",
          "variable.tune_rz = variable.on ? (variable.d0 - 5) * 15 : 0;",
          "variable.tune_ry = variable.on ? (variable.d1 - 5) * 15 : 0;",
          "variable.tune_rx = variable.on ? (variable.d2 - 5) * 15 : 0;",
          "variable.tune_pz = variable.on ? (variable.d3 - 5) * 2 : 0;",
          "variable.tune_py = variable.on ? (variable.d4 - 5) * 2 : 0;",
          "variable.tune_px = variable.on ? (variable.d5 - 5) * 2 : 0;"
        ],
        "animate": ["wield"]
      },
      "render_controllers": ["controller.render.item_default"]
    }
  }
}
