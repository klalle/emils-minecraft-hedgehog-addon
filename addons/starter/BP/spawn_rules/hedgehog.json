        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "value": "forest" },
            { "test": "has_biome_tag", "value": "dappled_forest" },
            { "test": "has_biome_tag", "value": "taiga" },
            { "test": "has_biome_tag", "value": "savanna" },
            { "test": "has_biome_tag", "value": "plains" }
          ]
        }
      }
    ]
  }
