{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "starter:hedgehog",
      "population_control": "animal"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:dirt"],
        "minecraft:brightness_filter": { "min": 7, "max": 15, "adjust_for_weather": false },
        "minecraft:herd": { "min_size": 1, "max_size": 2 },
        "minecraft:weight": { "default": 8 },
        "minecraft:density_limit": { "surface": 4 },
        "minecraft:biome_filter": {
          "any_of": [
            { "test": "has_biome_tag", "operator": "==", "value": "forest" },
            { "test": "has_biome_tag", "operator": "==", "value": "taiga" }
          ]
        }
      }
    ]
  }
}
